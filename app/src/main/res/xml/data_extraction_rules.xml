<?xml version="1.0" encoding="utf-8" standalone="yes"?><!--
   Reglas de extracción de datos (Fase 4, Android 12+).

   Misma decisión que en backup_rules.xml: las credenciales no salen del
   dispositivo (la clave del Keystore no se puede respaldar), las facturas sí.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="diarix_credenciales.bin"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="diarix_credenciales.bin"/>
    </device-transfer>
</data-extraction-rules>