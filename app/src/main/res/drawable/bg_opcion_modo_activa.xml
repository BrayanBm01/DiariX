<?xml version="1.0" encoding="utf-8"?>
<!--
  Opción del selector que corresponde al área en la que ya se está. Se marca
  con un borde de 2dp en el color del área; el interior sigue siendo la misma
  carta blanca, para no inventar un estilo nuevo.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#FFFFFF"/>

    <corners android:radius="20dp"/>

    <stroke
        android:width="2dp"
        android:color="#0AA87A"/>

</shape>