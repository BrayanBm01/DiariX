    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960">

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M504,480 L320,296 L376,240 L616,480 L376,720 L320,664 Z" />

</vector>