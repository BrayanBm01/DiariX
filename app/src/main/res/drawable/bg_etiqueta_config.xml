<?xml version="1.0" encoding="utf-8"?>
<!--
  Etiqueta pequeña de "Cuenta de Google".

  Redondeada y en un tono neutro, no con el azul de Google: la app no usa los
  colores de marca de terceros, y un azul de Google al lado del azul de la app
  haría pensar que es un botón de Google.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#F2F4F8" />

    <corners android:radius="8dp" />

    <stroke
        android:width="1dp"
        android:color="#E3E8F2" />

</shape>