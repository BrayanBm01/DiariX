<?xml version="1.0" encoding="utf-8"?>

<!--
  DIARIX · Fase 0.1 · Ayuda.

  NO es un sistema de soporte: no hay chat, ni correo, ni tickets, ni números de
  teléfono, porque DiariX no tiene nada de eso detrás. Poner un "Escríbenos" que
  no llega a nadie es peor que no poner nada.

  Lo que sí hay son respuestas a las preguntas REALES de esta versión:

    · Qué son las dos áreas y dónde se cambia de una a otra.
    · Qué hace cada pestaña del área de facturación.
    · Qué hay en el área de préstamos HOY (una pantalla y una explicación: no se
      insinúa que existan módulos que todavía no existen).
    · Dónde están el QR de los comprobantes y el respaldo.

  Y una última frase que dice con claridad que esto no es soporte. Enseñar los
  límites de la ayuda es parte de la ayuda: quien no encuentra su respuesta aquí
  tiene que poder distinguir "DiariX no lo tiene" de "DiariX lo tiene y no me lo
  encontré".
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ayuda_titulo"
            android:textColor="@color/texto_principal_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ayuda_subtitulo"
            android:textColor="@color/gris_etiqueta"
            android:textSize="13sp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!-- LAS DOS ÁREAS -->

            <TextView
                style="@style/TituloDeSeccion"
                android:text="@string/ayuda_seccion_areas" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ayuda_areas_texto"
                        android:textColor="@color/texto_principal_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_etiqueta_config"
                        android:padding="12dp"
                        android:text="@string/ayuda_areas_camino"
                        android:textColor="#5A6182"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- PESTAÑAS DE FACTURACIÓN -->

            <TextView
                style="@style/TituloDeSeccion"
                android:text="@string/ayuda_seccion_pestanas" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_pestana_inicio"
                            android:textColor="@color/texto_principal_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ayuda_pestana_inicio_detalle"
                            android:textColor="@color/gris_etiqueta"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <View style="@style/SeparadorDeFila" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_pestana_registros"
                            android:textColor="@color/texto_principal_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ayuda_pestana_registros_detalle"
                            android:textColor="@color/gris_etiqueta"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <View style="@style/SeparadorDeFila" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_pestana_estadisticas"
                            android:textColor="@color/texto_principal_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ayuda_pestana_estadisticas_detalle"
                            android:textColor="@color/gris_etiqueta"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <View style="@style/SeparadorDeFila" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_pestana_historial"
                            android:textColor="@color/texto_principal_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ayuda_pestana_historial_detalle"
                            android:textColor="@color/gris_etiqueta"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <View style="@style/SeparadorDeFila" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_pestana_configuracion"
                            android:textColor="@color/texto_principal_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ayuda_pestana_configuracion_detalle"
                            android:textColor="@color/gris_etiqueta"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- PRÉSTAMOS: LO QUE HAY Y LO QUE NO -->

            <TextView
                style="@style/TituloDeSeccion"
                android:text="@string/ayuda_seccion_prestamos" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ayuda_prestamos_estado"
                        android:textColor="@color/texto_principal_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/ayuda_prestamos_en_construccion"
                        android:textColor="@color/gris_etiqueta"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- TUS DATOS -->

            <TextView
                style="@style/TituloDeSeccion"
                android:text="@string/ayuda_seccion_tus_datos" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_dato_qr"
                            android:textColor="@color/texto_principal_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ayuda_dato_qr_detalle"
                            android:textColor="@color/gris_etiqueta"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <View style="@style/SeparadorDeFila" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_dato_respaldo"
                            android:textColor="@color/texto_principal_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ayuda_dato_respaldo_detalle"
                            android:textColor="@color/gris_etiqueta"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <View style="@style/SeparadorDeFila" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ayuda_dato_sesion"
                            android:textColor="@color/texto_principal_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ayuda_dato_sesion_detalle"
                            android:textColor="@color/gris_etiqueta"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- EL LÍMITE DE ESTA AYUDA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_etiqueta_config"
                android:padding="16dp"
                android:text="@string/ayuda_sin_soporte"
                android:textColor="#5A6182"
                android:textSize="13sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>