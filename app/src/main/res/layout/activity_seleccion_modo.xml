<?xml version="1.0" encoding="utf-8"?>

<!--
  DIARIX · Fase 0.1 · "¿Qué quieres gestionar?" a pantalla completa.

  Es la primera decisión real que se le pide a quien entra. Por eso es una
  pantalla y no un diálogo: hay sitio para decir qué es cada área, sin prisa y
  sin una opción de cancelar que devuelva al login.

  Las dos cartas usan EXACTAMENTE el mismo componente visual que el diálogo que
  ya existía en la Fase 0 (fondo `bg_opcion_modo`, barra de color del área,
  título + descripción), para que el gesto se parezca y la persona que ya conoce
  el diálogo lo reconozca.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F3FA"
    android:orientation="vertical">

    <!-- ENCABEZADO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="40dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitStart"
            android:src="@drawable/diarix_logotipo" />

    </LinearLayout>

    <!-- PREGUNTA -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp"
        android:text="@string/selector_modo_titulo"
        android:textColor="#1C2340"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        android:text="@string/selector_modo_instruccion"
        android:textColor="#7A7A9D"
        android:textSize="14sp" />

    <!--
      CONTENIDO DESPLAZABLE

      Se desplaza y no se fija, porque las dos cartas + los textos no caben en un
      teléfono pequeño y lo que no cabe se cortaría justo donde está la
      decisión. En un teléfono grande simplemente sobra espacio abajo.
    -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- FACTURACIÓN -->

            <LinearLayout
                android:id="@+id/opcionFacturacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_opcion_modo"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <View
                    android:layout_width="5dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_modo_facturacion" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloOpcion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modo_facturacion"
                        android:textColor="#1C2340"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtResumenOpcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/modo_facturacion_resumen"
                        android:textColor="#7A7A9D"
                        android:textSize="13sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/modo_facturacion"
                    android:src="@drawable/ic_facturacion"
                    app:tint="#0AA87A" />

            </LinearLayout>

            <!-- PRÉSTAMOS -->

            <LinearLayout
                android:id="@+id/opcionPrestamos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_opcion_modo"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <View
                    android:layout_width="5dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_modo_prestamos" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloOpcionPrestamos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modo_prestamos"
                        android:textColor="#1C2340"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtResumenOpcionPrestamos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/modo_prestamos_resumen"
                        android:textColor="#7A7A9D"
                        android:textSize="13sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/modo_prestamos"
                    android:src="@drawable/ic_prestamos"
                    app:tint="#2B6ED4" />

            </LinearLayout>

            <!--
              AVISO DE LA SEGUNDA OPCIÓN

              Préstamos está en construcción y esta pantalla es la primera vez que
              se ofrece. Decirlo aquí, en el momento de elegir, es mejor que
              descubrirlo después: alguien que elige Préstamos tiene que saber
              que ve una pantalla preparada, no una con módulos que faltan.
            -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_chip_normal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:text="@string/selector_modo_aviso_prestamos"
                android:textColor="#7A7A9D"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>