<?xml version="1.0" encoding="utf-8"?><!--
    Pantalla de acceso a DiariX — rediseño visual exclusivo.

    Los ids (edtNit, edtEmail, edtPassword, btnEntrar, btnGoogle, txtError,
    progreso, loginContenido) y los atributos funcionales (inputType,
    imeOptions, visibilidad, enabled) son los MISMOS que usa LoginActivity.kt.
    Solo cambian presentación, textos visibles y recursos con prefijo login_.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/loginContenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/login_margen_horizontal"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/login_margen_horizontal"
        android:paddingBottom="24dp">

        <!-- MARCA -->

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="196dp"
            android:layout_height="52dp"
            android:adjustViewBounds="true"
            android:contentDescription="Logotipo de DiariX"
            android:scaleType="fitCenter"
            android:src="@drawable/diarix_logotipo" />

        <!-- Acento de marca: una línea fina, sin decoración recargada. -->
        <View
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/login_accent" />

        <!-- BIENVENIDA -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/login_bienvenido_titulo"
            android:textColor="@color/texto_principal_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/login_bienvenido_subtitulo"
            android:textColor="@color/gris_etiqueta"
            android:textSize="14sp" />

        <!-- FORMULARIO -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/borde_suave"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp">

                <!-- NIT (el código lo envía como null si está vacío) -->

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_nit_hint"
                    app:boxBackgroundColor="@color/white"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/borde_campo"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/etiqueta_campo"
                    app:startIconDrawable="@drawable/ic_nit"
                    app:startIconTint="@color/login_icono_campo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLines="1"
                        android:textColor="@color/texto_principal_dark"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- CORREO (mismo campo de siempre; antes se etiquetaba "Usuario") -->

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/login_correo_hint"
                    app:boxBackgroundColor="@color/white"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/borde_campo"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:hintTextColor="@color/etiqueta_campo"
                    app:startIconDrawable="@drawable/ic_usuario"
                    app:startIconTint="@color/login_icono_campo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/texto_principal_dark"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- CONTRASEÑA (toggle nativo de Material, sin lógica nueva) -->

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/login_password_hint"
                    app:boxBackgroundColor="@color/white"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/borde_campo"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconMode="password_toggle"
                    app:hintTextColor="@color/etiqueta_campo"
                    app:startIconDrawable="@drawable/ic_password"
                    app:startIconTint="@color/login_icono_campo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/texto_principal_dark"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ERROR (oculto hasta que LoginActivity lo muestra) -->

                <TextView
                    android:id="@+id/txtError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/login_error_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/texto_error"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- BOTÓN PRINCIPAL -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEntrar"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:text="@string/login_iniciar_sesion"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_boton_ingresar"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/bg_boton_ingresar"
                    app:cornerRadius="14dp" />

                <!-- SEPARADOR -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/borde_suave" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/login_separador"
                        android:textColor="@color/gris_etiqueta"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/borde_suave" />

                </LinearLayout>

                <!-- BOTÓN GOOGLE: mismo id y mismo listener que antes -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:text="@string/login_continuar_con_google"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_principal_dark"
                    android:textSize="15sp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_google"
                    app:iconTint="@null"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="20dp"
                    app:strokeColor="@color/borde_suave"
                    app:strokeWidth="1dp" />

                <!-- PROGRESO: lo controla setOcupado() en LoginActivity -->

                <ProgressBar
                    android:id="@+id/progreso"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/verde_pago"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- PIE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/login_pie"
            android:textColor="@color/gris_etiqueta"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
