<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F3FA">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registros"
            android:textColor="#1C2340"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtContadorRegistros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 días registrados"
            android:textColor="#7A7A9D"
            android:textSize="13sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- PESTAÑAS -->

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutRegistros"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:background="#FFFFFF"
        app:tabIndicator="@drawable/bg_tab_seleccionada"
        app:tabIndicatorColor="#0AA87A"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorGravity="stretch"
        app:tabIndicatorHeight="40dp"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabRippleColor="#00000000"
        app:tabTextAppearance="@style/TextoPestanaRegistros"
        app:tabTextColor="#7A7A9D"
        app:tabSelectedTextColor="#FFFFFF"
        app:tabPaddingStart="12dp"
        app:tabPaddingEnd="12dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registros diarios"/>

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Papelera"/>

    </com.google.android.material.tabs.TabLayout>

    <!-- FILTRO FECHA (solo pestaña registros) -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardFiltroFecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/txtFechaSeleccionada"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Seleccionar fecha"
                android:textColor="#1C2340"
                android:textSize="16sp"/>

            <ImageButton
                android:id="@+id/btnCalendario"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_my_calendar"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- LISTAS -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRegistros"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/txtVacioRegistros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Aún no hay registros diarios"
            android:textColor="#7A7A9D"
            android:textSize="15sp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPapelera"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/txtVaciaPapelera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="La papelera está vacía"
            android:textColor="#7A7A9D"
            android:textSize="15sp"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- MENU INFERIOR -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/MenuInferiorCompacto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_bottom"/>

</LinearLayout>
