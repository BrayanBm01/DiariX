<?xml version="1.0" encoding="utf-8"?>
<!--
  DIARIX · Fase 3 · Selector de cliente para el alta de préstamo.

  Reutiliza el padrón de clientes `GET /clientes` (el mismo repositorio que la
  pestaña Clientes) con su búsqueda `q` y su paginación del servidor, pero en
  modo "elegir uno": el toque en una fila devuelve ese cliente a la pantalla
  que lo pidió, en vez de abrir su ficha.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F3FA"
    android:orientation="vertical">

    <!-- ENCABEZADO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="28dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnVolverSelector"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:padding="10dp"
            android:rotation="180"
            android:src="@drawable/ic_chevron"
            app:tint="#5A6182" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Elegir cliente"
            android:textColor="#1C2340"
            android:textSize="22sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- BÚSQUEDA -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/edtBuscarClienteSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_borde"
            android:hint="Buscar por nombre, documento o teléfono"
            android:inputType="text"
            android:maxLength="120"
            android:padding="13dp"
            android:textColor="#000000"
            android:textColorHint="#7A7A9D"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- CONTENIDO -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progresoSelector"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="#2B6ED4"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/estadoVacioSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtVacioSelector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#1C2340"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/txtVacioSelectorMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#7A7A9D"
                android:textSize="13sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/estadoErrorSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No se pudieron cargar los clientes"
                android:textColor="#1C2340"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtErrorSelector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#7A7A9D"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnReintentarSelector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#2B6ED4"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="Reintentar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaClientesSelector"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:visibility="gone"/>

    </FrameLayout>

</LinearLayout>