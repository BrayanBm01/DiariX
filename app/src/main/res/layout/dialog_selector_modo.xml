<?xml version="1.0" encoding="utf-8"?>
<!--
  DIARIX · Fase 0 · "¿Qué quieres gestionar?".

  Las dos áreas de DiariX, lado a lado y con la vigente marcada. Es la pregunta
  que hace explícita una separación que la app sostiene por dentro: no hay
  menús mezclados ni listas largas de botones, solo dos entradas y una
  descripción de cada una.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp">

    <!-- FACTURACIÓN -->
    <LinearLayout
        android:id="@+id/opcionFacturacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_opcion_modo"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <View
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_modo_facturacion" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modo_facturacion"
                android:textColor="#1C2340"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/modo_facturacion_resumen"
                android:textColor="#7A7A9D"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtMarca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/modo_vigente"
            android:textColor="#0AA87A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="invisible" />

    </LinearLayout>

    <!-- PRÉSTAMOS -->
    <LinearLayout
        android:id="@+id/opcionPrestamos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_opcion_modo"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <View
            android:layout_width="4dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_modo_prestamos" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/modo_prestamos"
                android:textColor="#1C2340"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/modo_prestamos_resumen"
                android:textColor="#7A7A9D"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtMarcaPrestamos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/modo_vigente"
            android:textColor="#2B6ED4"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="invisible" />

    </LinearLayout>

</LinearLayout>