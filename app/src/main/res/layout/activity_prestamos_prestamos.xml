<?xml version="1.0" encoding="utf-8"?>
<!--
  DIARIX · Fase 3 · Listado de préstamos (RF-05 a RF-09).

  Pantalla completa de la pestaña `nav_prestamos_prestamos`, con la misma
  anatomía que `activity_clientes` (encabezado blanco, contenido sobre gris
  azulado, navegación inferior) más DOS cosas propias del módulo:

  1. El filtro por ESTADO DERIVADO (RF-09). El estado lo calcula el servidor y
     el filtro se lo pide al servidor: la app no tiene una copia local que
     despliegue. "Todos" va sin parámetro `estado`; cada chip con su valor.

  2. Cuatro estados de pantalla (Cargando, Vacío, Error, Lista), igual que el
     padrón de clientes: sin conexión esto dice Error con Reintentar, y no
     una lista que parece cargada.

  El botón inferior abre el formulario de alta; la paginación es del servidor.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F3FA"
    android:orientation="vertical">

    <!-- ENCABEZADO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="36dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Préstamos"
                android:textColor="#1C2340"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtResumenPrestamos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#7A7A9D"
                android:textSize="13sp"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnAbrirConfiguracion"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/configuracion_titulo"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:tint="#5A6182" />

    </LinearLayout>

    <!-- BÚSQUEDA Y FILTRO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/edtBuscarPrestamo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_borde"
            android:hint="Buscar préstamo por cliente"
            android:inputType="text"
            android:maxLength="120"
            android:padding="13dp"
            android:textColor="#000000"
            android:textColorHint="#7A7A9D"
            android:textSize="14sp"/>

        <!-- Filtro de estado derivado: dos filas de tres, para caber en un
             teléfono de 5 pulgadas sin que el chip se coma su etiqueta. -->

        <LinearLayout
            android:id="@+id/filaFiltrosPrestamos1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtFiltroTodos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_filtro_activo"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Todos"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtFiltroActivos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_filtro"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Activos"
                android:textColor="#4A5578"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/txtFiltroVencidos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_filtro"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Vencidos"
                android:textColor="#4A5578"
                android:textSize="12sp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/filaFiltrosPrestamos2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtFiltroPorIniciar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_filtro"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Por iniciar"
                android:textColor="#4A5578"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/txtFiltroPagados"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_filtro"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Pagados"
                android:textColor="#4A5578"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/txtFiltroCancelados"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_filtro"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Cancelados"
                android:textColor="#4A5578"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- CONTENIDO: un solo hijo visible cada vez -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1 · CARGANDO -->

        <ProgressBar
            android:id="@+id/progresoPrestamos"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="#2B6ED4"
            android:visibility="gone"/>

        <!-- 2 · VACÍO -->

        <LinearLayout
            android:id="@+id/estadoVacioPrestamos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_prestamos"
                app:tint="#C9D5E8"/>

            <TextView
                android:id="@+id/txtVacioTituloPrestamos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Todavía no hay préstamos"
                android:textColor="#1C2340"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtVacioMensajePrestamos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Registra el primero con el botón de abajo."
                android:textColor="#7A7A9D"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- 3 · ERROR -->

        <LinearLayout
            android:id="@+id/estadoErrorPrestamos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No se pudieron cargar los préstamos"
                android:textColor="#1C2340"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtErrorPrestamos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#7A7A9D"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnReintentarPrestamos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#2B6ED4"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="Reintentar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- 4 · LISTA -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaPrestamos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- PAGINACIÓN (solo cuando hay más de una página) -->

    <LinearLayout
        android:id="@+id/barraPaginacionPrestamos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnPaginaAnteriorPrestamos"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Página anterior"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/ic_chevron"
            app:tint="#2B6ED4"/>

        <TextView
            android:id="@+id/txtPaginaPrestamos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#7A7A9D"
            android:textSize="13sp"/>

        <ImageButton
            android:id="@+id/btnPaginaSiguientePrestamos"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Página siguiente"
            android:padding="8dp"
            android:src="@drawable/ic_chevron"
            app:tint="#2B6ED4"/>

    </LinearLayout>

    <!-- ALTA -->

    <Button
        android:id="@+id/btnNuevoPrestamo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#2B6ED4"
        android:drawableStart="@drawable/ic_add"
        android:drawablePadding="10dp"
        android:drawableTint="#FFFFFF"
        android:gravity="center"
        android:padding="13dp"
        android:text="Nuevo préstamo"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"/>

    <!-- NAVEGACIÓN INFERIOR (el azul del área de PRÉSTAMOS) -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/MenuInferiorCompactoPrestamos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>