<?xml version="1.0" encoding="utf-8"?>
<!--
  DIARIX · Fase 2 · Listado de clientes (RF-01 a RF-04).

  Vive en el área de PRÉSTAMOS: es la pantalla de la pestaña
  `nav_prestamos_clientes` (cambio rápido pos-Fase 2), y por eso lleva la
  barra azul del área, no la verde de Facturación. Estructura de las demás
  pantallas de la app: encabezado blanco, contenido sobre gris azulado y
  navegación inferior, sin tira de área (Fase 0.1): el nombre del área ya no
  se pone en cada pantalla.

  CUATRO ESTADOS A LA VISTA, y no tres. La pantalla empieza en Cargando,
  pasa a Vacío, a Error o a la lista, y solo uno de los cuatro está visible
  cada vez:
    - Cargando: el servidor puede tardar y sin indicador se toca dos veces.
    - Vacío: la lista sin registros no es un fallo, es "todavía no hay
      clientes", con su botón de alta para que no sea una pantalla sin salida.
    - Error: la app no tiene caché local de clientes, así que sin conexión
      esto es lo que hay que decir. Se dice de frente y con reintentar, no
      con un spinner eterno.
    - Lista: el RecyclerView y nada más.

  La paginación es del servidor: aquí solo se pide "página N" y se pinta lo
  que llega. La barra con flechas se oculta cuando cabe todo en una página,
  para que una sola página no lleve controles inútiles.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F3FA"
    android:orientation="vertical">

    <!-- ENCABEZADO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="36dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clientes"
                android:textColor="#1C2340"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtResumenClientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#7A7A9D"
                android:textSize="13sp"/>

        </LinearLayout>

        <!--
          El engranaje de Configuración, igual que en el resto de pantallas del
          área de Préstamos: Configuración se abre desde cualquiera de ellas.
        -->
        <ImageButton
            android:id="@+id/btnAbrirConfiguracion"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/configuracion_titulo"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:tint="#5A6182" />

    </LinearLayout>

    <!-- BÚSQUEDA -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <EditText
            android:id="@+id/edtBuscarCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edittext_borde"
            android:hint="Buscar por nombre, documento o teléfono"
            android:inputType="text"
            android:maxLength="120"
            android:padding="13dp"
            android:textColor="#000000"
            android:textColorHint="#7A7A9D"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- CONTENIDO: un solo hijo visible cada vez -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1 · CARGANDO -->

        <ProgressBar
            android:id="@+id/progresoClientes"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="#0AA87A"
            android:visibility="gone"/>

        <!-- 2 · VACÍO -->

        <LinearLayout
            android:id="@+id/estadoVacioClientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_clientes"
                app:tint="#C9D5E8"/>

            <TextView
                android:id="@+id/txtVacioTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Todavía no hay clientes"
                android:textColor="#1C2340"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtVacioMensaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Registra el primero con el botón de abajo."
                android:textColor="#7A7A9D"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- 3 · ERROR -->

        <LinearLayout
            android:id="@+id/estadoErrorClientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No se pudieron cargar los clientes"
                android:textColor="#1C2340"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtErrorClientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#7A7A9D"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnReintentarClientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#2B6ED4"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="Reintentar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- 4 · LISTA -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaClientes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- PAGINACIÓN (solo cuando hay más de una página) -->

    <LinearLayout
        android:id="@+id/barraPaginacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnPaginaAnterior"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Página anterior"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/ic_chevron"
            app:tint="#2B6ED4"/>

        <TextView
            android:id="@+id/txtPaginaClientes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#7A7A9D"
            android:textSize="13sp"/>

        <ImageButton
            android:id="@+id/btnPaginaSiguiente"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Página siguiente"
            android:padding="8dp"
            android:src="@drawable/ic_chevron"
            app:tint="#2B6ED4"/>

    </LinearLayout>

    <!-- ALTA -->

    <Button
        android:id="@+id/btnNuevoCliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#2B6ED4"
        android:drawableStart="@drawable/ic_add"
        android:drawablePadding="10dp"
        android:gravity="center"
        android:padding="13dp"
        android:text="Nuevo cliente"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:drawableTint="#FFFFFF"/>

    <!-- NAVEGACIÓN INFERIOR (el azul del área de PRÉSTAMOS) -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/MenuInferiorCompactoPrestamos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
