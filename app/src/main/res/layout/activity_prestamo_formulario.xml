<?xml version="1.0" encoding="utf-8"?>
<!--
  DIARIX · Fase 3 · Alta de préstamo (RF-05 a RF-07).

  El formulario arma el `DatosDePrestamoNuevo` y la vista previa local con
  [CalculoDePrestamo]; el calendario lo hace el servidor en el alta. Campos:

   - Cliente: se elige en [SelectorDeClienteActivity] (el padrón de la sesión).
   - Fecha de inicio: DatePicker; el día elegido viaja como `yyyy-MM-dd`.
   - Monto: pesos enteros con miles en pantalla (watcher de este módulo).
   - Modalidad y cuotas: el ritmo y el número del acuerdo.
   - Forma de cálculo PORCENTAJE / TOTAL (excluyente, como en el backend).
   - Resumen: la vista previa del total y de la cuota con residuo.

  Nada de esto SUSTITUYE el cálculo del servidor: el total autoritativo es el
  que el backend devuelve con el calendario al registrar.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F3FA"
    android:orientation="vertical">

    <!-- ENCABEZADO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="28dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnVolverPrestamo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:padding="10dp"
            android:rotation="180"
            android:src="@drawable/ic_chevron"
            app:tint="#5A6182" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nuevo préstamo"
            android:textColor="#1C2340"
            android:textSize="22sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- FORMULARIO -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CLIENTE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cliente"
                android:textColor="#1C2340"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/tarjetaElegirCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clientes"
                    app:tint="#2B6ED4"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtClienteSeleccionado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Elegir el cliente"
                        android:textColor="#7A7A9D"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/txtClienteDocumentoSeleccionado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#B4C1D2"
                        android:textSize="12sp"/>

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron"
                    app:tint="#B4C1D2"/>

            </LinearLayout>

            <!-- FECHA DE INICIO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Fecha de inicio"
                android:textColor="#1C2340"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/tarjetaFechaInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar"
                    app:tint="#2B6ED4"/>

                <TextView
                    android:id="@+id/txtFechaInicio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textSize="15sp"
                    android:textColor="#1C2340"/>

            </LinearLayout>

            <!-- MONTO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Monto a prestar"
                android:textColor="#1C2340"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtMontoPrestamo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_borde"
                android:hint="$0"
                android:inputType="number"
                android:maxLength="12"
                android:padding="13dp"
                android:textColor="#000000"
                android:textColorHint="#B4C1D2"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- MODALIDAD -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Modalidad"
                android:textColor="#1C2340"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtModalidadDiario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_filtro_activo"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Diario"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtModalidadSemanal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_filtro"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Semanal"
                    android:textColor="#4A5578"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtModalidadQuincenal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_filtro"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Quincenal"
                    android:textColor="#4A5578"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtModalidadMensual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_filtro"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Mensual"
                    android:textColor="#4A5578"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- NÚMERO DE CUOTAS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Número de cuotas"
                android:textColor="#1C2340"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/edtCuotasPrestamo"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_borde"
                android:hint="12"
                android:inputType="number"
                android:maxLength="2"
                android:padding="13dp"
                android:textColor="#000000"
                android:textColorHint="#B4C1D2"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- FORMA DE CÁLCULO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Forma de cálculo"
                android:textColor="#1C2340"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtTipoPorcentaje"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_filtro_activo"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Porcentaje"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtTipoTotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_filtro"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Total a pagar"
                    android:textColor="#4A5578"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- PORCENTAJE (PORCENTAJE) -->

            <EditText
                android:id="@+id/edtPorcentajePrestamo"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_borde"
                android:hint="%"
                android:inputType="numberDecimal"
                android:maxLength="6"
                android:padding="13dp"
                android:textColor="#000000"
                android:textColorHint="#B4C1D2"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="visible"/>

            <!-- TOTAL (TOTAL) -->

            <EditText
                android:id="@+id/edtTotalPrestamo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_borde"
                android:hint="Total a pagar, por ejemplo $1.200.000"
                android:inputType="number"
                android:maxLength="12"
                android:padding="13dp"
                android:textColor="#000000"
                android:textColorHint="#B4C1D2"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <!-- VISTA PREVIA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/txtPreviewTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resumen del acuerdo"
                    android:textColor="#1C2340"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtPreviewTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#1C2340"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtPreviewCuota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#7A7A9D"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/txtPreviewNota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#7A8194"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- ALTA -->

            <Button
                android:id="@+id/btnRegistrarPrestamo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#2B6ED4"
                android:gravity="center"
                android:padding="13dp"
                android:text="Registrar préstamo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>