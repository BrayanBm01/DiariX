<?xml version="1.0" encoding="utf-8"?>

<!--
  DIARIX · Fase 0.1 · Acerca de DiariX.

  Lo mínimo y lo cierto: el nombre, QUÉ es la app, la versión REAL (que sale de
  `BuildConfig` en código, no de un texto) y una nota de privacidad que describe
  lo que la app hace de verdad con los datos.

  NO lleva enlaces a "términos" ni "privacidad" ni "contacto" porque no hay
  ninguna de esas páginas escritas ni sitio web al que ir. Poner un enlace a una
  política que nadie ha escrito es un fallo legal y de confianza a la vez: quien
  la toca para leerla se encuentra con que no existe, y ya no vuelve a fiarse de
  los otros enlaces de la pantalla.

  El aviso sobre el estado de Préstamos va aquí y no escondido: quien instala
  la app, entra al área de préstamos y ve que no hay módulos, tiene que poder
  leer que eso es porque se está construyendo y no porque su cuenta esté mal.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/acerca_titulo"
            android:textColor="@color/texto_principal_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="196dp"
                android:layout_height="52dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/acerca_app_nombre"
                android:scaleType="fitCenter"
                android:src="@drawable/diarix_logotipo" />

            <TextView
                android:id="@+id/txtVersionAcercaDe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/gris_etiqueta"
                android:textSize="14sp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/acerca_que_es"
                        android:textColor="@color/texto_principal_dark"
                        android:textSize="14sp" />

                    <View
                        style="@style/SeparadorDeFila"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/acerca_privacidad"
                        android:textColor="@color/gris_etiqueta"
                        android:textSize="13sp" />

                    <View
                        style="@style/SeparadorDeFila"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/acerca_prestamos_estado"
                        android:textColor="@color/gris_etiqueta"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>