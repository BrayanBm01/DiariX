<?xml version="1.0" encoding="utf-8"?>
<!--
  DIARIX · Fase 4 · COBROS del área de Préstamos.

  La pestaña que en Fase 1 era una pantalla vacía muestra los cobros con datos
  REALES de `GET /cobros`, paginados por el servidor. La categoría —Hoy,
  Vencidas, Próximas— también la filtra el servidor: el chip solo se repite.

  Misma anatomía que el listado de préstamos: encabezado blanco, contenido
  sobre gris azulado, cuatro estados (Cargando, Vacío, Error, Lista), barra de
  paginación y navegación inferior del área.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F3FA"
    android:orientation="vertical">

    <!-- ENCABEZADO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="36dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cobros"
                android:textColor="#1C2340"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtResumenCobros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#7A7A9D"
                android:textSize="13sp"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnAbrirConfiguracion"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/configuracion_titulo"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:tint="#5A6182" />

    </LinearLayout>

    <!-- FILTRO POR CATEGORÍA -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtCategoriaHoy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_filtro_activo"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Hoy"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtCategoriaVencidas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_filtro"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Vencidas"
                android:textColor="#4A5578"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/txtCategoriaProximas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_filtro"
                android:gravity="center"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Próximas"
                android:textColor="#4A5578"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- CONTENIDO: un solo hijo visible cada vez -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1 · CARGANDO -->

        <ProgressBar
            android:id="@+id/progresoCobros"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:indeterminateTint="#2B6ED4"
            android:visibility="gone"/>

        <!-- 2 · VACÍO -->

        <LinearLayout
            android:id="@+id/estadoVacioCobros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cobros"
                app:tint="#C9D5E8"/>

            <TextView
                android:id="@+id/txtVacioTituloCobros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="#1C2340"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtVacioMensajeCobros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#7A7A9D"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- 3 · ERROR -->

        <LinearLayout
            android:id="@+id/estadoErrorCobros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No se pudieron cargar los cobros"
                android:textColor="#1C2340"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtErrorCobros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#7A7A9D"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnReintentarCobros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#2B6ED4"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="Reintentar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- 4 · LISTA -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaCobros"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- PAGINACIÓN (solo cuando hay más de una página) -->

    <LinearLayout
        android:id="@+id/barraPaginacionCobros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnPaginaAnteriorCobros"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Página anterior"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/ic_chevron"
            app:tint="#2B6ED4"/>

        <TextView
            android:id="@+id/txtPaginaCobros"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#7A7A9D"
            android:textSize="13sp"/>

        <ImageButton
            android:id="@+id/btnPaginaSiguienteCobros"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Página siguiente"
            android:padding="8dp"
            android:src="@drawable/ic_chevron"
            app:tint="#2B6ED4"/>

    </LinearLayout>

    <!-- NAVEGACIÓN INFERIOR (el azul del área de PRÉSTAMOS) -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/MenuInferiorCompactoPrestamos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>