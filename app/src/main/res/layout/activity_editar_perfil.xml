<?xml version="1.0" encoding="utf-8"?>

<!--
  DIARIX · Fase 0.1 · Editar perfil.

  Solo DOS campos, y son los dos únicos que el backend acepta en
  `PATCH /usuarios/yo`: el nombre completo y el teléfono. Todo lo demás de esta
  pantalla es lectura, y se explica POR QUÉ no se puede cambiar en vez de
  dejarlo como un campo deshabilitado sin explicación (ver los textos de abajo
  y `docs/FASE-0-SEPARACION-DE-MODOS.md`).

  El correo se enseña en un bloque aparte, con su explicación, y NO dentro de
  un campo de texto: si estuviera en un `EditText` aunque fuera de solo
  lectura, parecería editable y la primera vez que alguien lo toque pensará que
  la app está rota.

  El botón "Guardar" va al final y no flotando: en un teléfono pequeño con el
  teclado abierto el botón flotante acaba debajo del teclado, y el error
  "no encuentro Guardar" se repite.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_editar_titulo"
            android:textColor="@color/texto_principal_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/perfil_editar_subtitulo"
            android:textColor="@color/gris_etiqueta"
            android:textSize="13sp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <!--
              IDENTIDAD

              Lo que identifica la cuenta y no se toca. Va PRIMERO para que nadie
              busque un campo de correo editable por toda la pantalla: si está,
              está arriba, y es de lectura.
            -->

            <TextView
                style="@style/TituloDeSeccion"
                android:text="@string/configuracion_seccion_perfil" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/perfil_campo_correo"
                        android:textColor="@color/gris_etiqueta"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCorreoSoloLectura"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="middle"
                        android:maxLines="2"
                        android:textColor="@color/texto_principal_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/etiquetaGoogleEdicion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_etiqueta_config"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:text="@string/perfil_cuenta_google"
                        android:textColor="#5A6182"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/perfil_correo_solo_lectura"
                        android:textColor="@color/gris_etiqueta"
                        android:textSize="12sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!--
              DATOS QUE SÍ PUEDES CAMBIAR

              Los dos campos que acepta `PATCH /usuarios/yo`, con los mismos
              límites que pone el backend (160 y 32): se avisa antes de guardar
              con un `maxLength` en el propio campo, no con un error después.
            -->

            <TextView
                style="@style/TituloDeSeccion"
                android:text="@string/perfil_seccion_editable" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="@color/white"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/borde_campo"
                        app:counterEnabled="true"
                        app:counterMaxLength="160"
                        app:hintTextColor="@color/etiqueta_campo"
                        android:hint="@string/perfil_campo_nombre">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNombreCompleto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLength="160"
                            android:maxLines="1"
                            android:textColor="@color/texto_principal_dark"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:boxBackgroundColor="@color/white"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/borde_campo"
                        app:counterEnabled="true"
                        app:counterMaxLength="32"
                        app:hintTextColor="@color/etiqueta_campo"
                        android:hint="@string/perfil_campo_telefono">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtTelefono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="phone"
                            android:maxLength="32"
                            android:maxLines="1"
                            android:textColor="@color/texto_principal_dark"
                            android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/perfil_telefono_ayuda"
                        android:textColor="@color/gris_etiqueta"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txtErrorEdicion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/texto_error"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarPerfil"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:text="@string/perfil_guardar"
                android:textAllCaps="false"
                android:textColor="@color/texto_boton_ingresar"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/bg_boton_ingresar"
                app:cornerRadius="16dp" />

            <ProgressBar
                android:id="@+id/progresoGuardar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:indeterminateTint="@color/verde_pago"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>