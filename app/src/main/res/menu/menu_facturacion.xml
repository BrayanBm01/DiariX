<?xml version="1.0" encoding="utf-8"?>
<!--
  DIARIX · Menú del área de FACTURACIÓN.

  CINCO pestañas, con Inicio en el CENTRO exacto (tercera de cinco):

      Historial · Registros · Inicio · Gráficas · Configuración

  El orden cambió por decisión de producto: el registro diario es la tarea,
  pero el inicio es el punto de retorno y por eso ocupa el centro. Los ids
  NO cambian (`nav_inicio`, `nav_registros`, `nav_estadisticas`,
  `nav_historial`, `nav_configuracion`), de modo que los mapas de navegación
  siguen resolviendo las mismas pantallas.

  - "Gráficas" es el título visible de `nav_estadisticas`. La pantalla sigue
    siendo `EstadisticasActivity` y no se toca.
  - "Configuración" deja la abreviatura "Config.": con cinco pestañas el
    ancho alcanza y una palabra completa se entiende mejor.

  Nada de esto toca `menu_prestamos.xml`, que sigue con sus cinco pestañas y
  sus ids prefijados con `nav_prestamos_`.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/nav_historial"
        android:icon="@drawable/ic_history"
        android:title="Historial"/>

    <item
        android:id="@+id/nav_registros"
        android:icon="@drawable/ic_receipt"
        android:title="Registros"/>

    <item
        android:id="@+id/nav_inicio"
        android:icon="@drawable/ic_home"
        android:title="Inicio"/>

    <item
        android:id="@+id/nav_estadisticas"
        android:icon="@drawable/ic_estadisticas"
        android:title="Gráficas"/>

    <item
        android:id="@+id/nav_configuracion"
        android:icon="@drawable/ic_settings"
        android:title="Configuración"/>

</menu>
