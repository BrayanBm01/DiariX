<?xml version="1.0" encoding="utf-8"?>
<!--
  DIARIX · Menú del área de FACTURACIÓN.

  CINCO pestañas: Inicio, Registros, Estadísticas, Historial y Configuración.

  CAMBIO DE RUMBO (pos-Fase 2): la barra vuelve a las cinco pestañas de toda
  la vida, con sus iconos originales. La Fase 2 la había reducido a cuatro —
  Registros y Estadísticas pasaron a ser accesos del final de Inicio y entró
  Clientes— y ese cambio se revierte:

  - `nav_registros` y `nav_estadisticas` vuelven a ser pestañas, con el icono
    que tenían: `ic_receipt` y `ic_estadisticas`.
  - `nav_clientes` se va de Facturación. El padrón de clientes pertenece al
    área de Préstamos y vive como `nav_prestamos_clientes` en
    `menu_prestamos.xml`, que aquí no se toca.
  - `nav_historial` vuelve a llamarse "Historial" (la Fase 2 lo había
    rebautizado "Facturas") y recupera su icono `ic_history`.

  Nada de esto toca `menu_prestamos.xml`, que sigue con sus cinco pestañas y
  sus ids prefijados con `nav_prestamos_`.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/nav_inicio"
        android:icon="@drawable/ic_home"
        android:title="Inicio"/>

    <item
        android:id="@+id/nav_registros"
        android:icon="@drawable/ic_receipt"
        android:title="Registros"/>

    <item
        android:id="@+id/nav_estadisticas"
        android:icon="@drawable/ic_estadisticas"
        android:title="Estadíst."/>

    <item
        android:id="@+id/nav_historial"
        android:icon="@drawable/ic_history"
        android:title="Historial"/>

    <item
        android:id="@+id/nav_configuracion"
        android:icon="@drawable/ic_settings"
        android:title="Config."/>

</menu>